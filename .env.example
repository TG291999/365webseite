# =========================================================================
# Propstack REST API — Zugangsdaten
#
# 1. Diese Datei nach ".env" kopieren:      cp .env.example .env
# 2. In der ".env" den echten Schlüssel eintragen.
# 3. Die ".env" niemals weitergeben, committen oder ins Frontend laden.
#
# Der Schlüssel wird ausschließlich serverseitig verwendet: ein Build-Skript
# holt die Objekte ab und schreibt sie in data/objekte.js. Der Browser
# bekommt den Schlüssel nie zu sehen.
# =========================================================================

PROPSTACK_API_BASE_URL=https://api.propstack.de/v1
PROPSTACK_API_KEY=
